		HealthText.BackgroundTransparency = 1
		HealthText.Position = UDim2.new(0, 0, 1, -12)
		HealthText.Size = UDim2.new(1, 0, 0, 12)
		HealthText.Font = Enum.Font.GothamBold
		HealthText.TextSize = 9
		HealthText.TextColor3 = Color3.new(1, 1, 1)
		HealthText.TextStrokeTransparency = 0.3
		HealthText.Parent = Billboard
	end

	local Box = Billboard:FindFirstChild("Box")
	local HealthBack = Billboard:FindFirstChild("HealthBack")
	local HealthText = Billboard:FindFirstChild("HealthText")

	if Box then Box.Visible = State.BoxESPEnabled end
	if HealthBack then HealthBack.Visible = State.HealthESPEnabled end
	if HealthText then HealthText.Visible = State.HealthESPEnabled end

	if State.HealthESPEnabled and HealthBack and HealthText then
		local MaxHealth = math.max(H.MaxHealth, 1)
		local Ratio = math.clamp(H.Health / MaxHealth, 0, 1)
		local Fill = HealthBack:FindFirstChild("HealthFill")
		
		if Fill then
			Fill.Size = UDim2.fromScale(1, Ratio)
			Fill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(70, 255, 100), Ratio)
		end
		
		HealthText.Text = Target.DisplayName .. " " .. math.floor(H.Health) .. "/" .. math.floor(MaxHealth)
	end
end

local function SetPlayerESP()
	if Runtime.ESPConnection then
		Runtime.ESPConnection:Disconnect()
		Runtime.ESPConnection = nil
	end

	if not State.BoxESPEnabled and not State.HealthESPEnabled then
		for _, Target in ipairs(Players:GetPlayers()) do
			RemoveESPFromCharacter(Target.Character)
		end
		return
	end

	local Accumulator = 0
	Runtime.ESPConnection = TrackConnection(RunService.Heartbeat:Connect(function(Delta)
		Accumulator = Accumulator + Delta
		if Accumulator < 0.15 then return end
		Accumulator = 0
		
		for _, Target in ipairs(Players:GetPlayers()) do
			UpdatePlayerESP(Target)
		end
	end))
	
	LogSuccess("ESP updated", "ESP")
end

