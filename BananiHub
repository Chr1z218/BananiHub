    end
    
    local Accumulator = 0
    Runtime.NoclipConnection = RunService.Stepped:Connect(function(_, Delta)
        Accumulator += Delta or 0
        if Accumulator < 0.10 then return end
        Accumulator = 0
        
        local C = Character()
        if not C then return end
        
        for _, Object in ipairs(C:GetDescendants()) do
            if Object:IsA("BasePart") then
                if Runtime.NoclipOriginalCollision[Object] == nil then
                    Runtime.NoclipOriginalCollision[Object] = Object.CanCollide
                end
                if Object.CanCollide then Object.CanCollide = false end
            end
        end
    end)
    
    LogSuccess("Noclip " .. (Value and "enabled" or "disabled"))
end

