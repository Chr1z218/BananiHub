local SafetyTiers = {
    COSMETIC = 1,
    MOVEMENT = 2,
    DETECTION = 3,
    HOSTILE = 4
}

local SafetyState = {
    CurrentTier = SafetyTiers.MOVEMENT,
    Locked = false,
    Reason = nil
}

local function CheckSafetyTier(RequiredTier)
    if SafetyState.Locked and SafetyState.CurrentTier > RequiredTier then
        return false, SafetyState.Reason or "Safety tier restriction"
    end
    return true, nil
end

local function SetSafetyTier(NewTier, Reason)
    SafetyState.CurrentTier = NewTier
    SafetyState.Reason = Reason
    LogInformation("Safety tier: " .. tostring(NewTier), "System")
end

