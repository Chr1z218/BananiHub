local ScriptExecutor = {
	loaded_scripts = {},
	environment = {},
	hooks = {}
}

function ScriptExecutor:create_sandbox()
	local sandbox = setmetatable({
		print = print,
		warn = warn,
		error = error,
		type = type,
		tostring = tostring,
		tonumber = tonumber,
		pairs = pairs,
		ipairs = ipairs,
		next = next,
		select = select,
		unpack = unpack,
		table = table,
		string = string,
		math = math,
		game = game,
		workspace = workspace,
		script = script,
		wait = wait,
		delay = delay,
		spawn = spawn,
		task = task,
		ExecutionPool = ExecutionPool,
		_G = {},
	}, {__index = _G})
	
	return sandbox
end

function ScriptExecutor:load(script_content, script_name)
	local Safe, Reason = CheckSafetyTier(SafetyTiers.HOSTILE)
	if not Safe then
		return false, Reason
	end
	
	local name = script_name or "script_" .. math.random(100000, 999999)
	
	local sandbox = self:create_sandbox()
	local chunk, load_err = loadstring(script_content)
	
	if not chunk then
		return false, "Load error: " .. tostring(load_err)
	end
	
	setfenv(chunk, sandbox)
	
	local success, exec_err = pcall(chunk)
	
	if success then
		self.loaded_scripts[name] = {
			content = script_content,
			sandbox = sandbox,
			executed_at = tick(),
			status = "success"
		}
		LogSuccess("Script loaded: " .. name, "ScriptExecutor")
		return true, name
	else
		return false, "Execution error: " .. tostring(exec_err)
	end
end

function ScriptExecutor:execute_remote(script_url)
	local Safe, Reason = CheckSafetyTier(SafetyTiers.HOSTILE)
	if not Safe then
		return false, Reason
	end
	
	local success, response = pcall(function()
		return HttpService:GetAsync(script_url)
	end)
	
	if not success then
		return false, "Fetch failed: " .. tostring(response)
	end
	
	return self:load(response, script_url)
end

function ScriptExecutor:inject_into_character(player, script_content)
	local Safe, Reason = CheckSafetyTier(SafetyTiers.HOSTILE)
	if not Safe then
		return false, Reason
	end
	
	if not player or not player.Parent then
		return false, "Player not found"
	end
	
	if not player.Character then
		return false, "Character not loaded"
	end
	
	local humanoid_root = player.Character:FindFirstChild("HumanoidRootPart")
	if not humanoid_root then
		return false, "HumanoidRootPart not found"
	end
	
	local injected_script = Instance.new("LocalScript")
	injected_script.Name = "InjectedScript_" .. math.random(100000, 999999)
	injected_script.Source = script_content
	injected_script.Parent = player.Character
	
	LogSuccess("Script injected into: " .. player.Name, "ScriptExecutor")
	return true, injected_script.Name
end

function ScriptExecutor:get_player(player_name_or_id)
	if type(player_name_or_id) == "number" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == player_name_or_id then
				return p
			end
		end
	end
	
	return Players:FindFirstChild(player_name_or_id)
end

function ScriptExecutor:list_loaded()
	local list = {}
	for name, data in pairs(self.loaded_scripts) do
		table.insert(list, {
			name = name,
			status = data.status,
			executed_at = data.executed_at
		})
	end
	return list
end

