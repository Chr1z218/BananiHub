Runtime.StopWaypointRoute = function(Silent)
    Runtime.RouteRunId += 1
    Runtime.RouteRunning = false
    Runtime.RoutePaused = false
    Runtime.RouteStatus = "Idle"
    Runtime.RouteCurrentIndex = 1
    Runtime.UpdateRouteUI()

    if not Silent then
        Notify("Waypoint Route", "Route stopped and reset to checkpoint 1.")
    end
end

Runtime.PauseWaypointRoute = function()
    if not Runtime.RouteRunning then
        Notify("Waypoint Route", "The route is not running.")
        return
    end

    if Runtime.RoutePaused then
        Notify("Waypoint Route", "The route is already paused.")
        return
    end

    Runtime.RoutePaused = true
    Runtime.RouteStatus = "Paused"
    Runtime.UpdateRouteUI()
    Notify("Waypoint Route", "Route paused.")
end

Runtime.PlayWaypointRoute = function()
    if #Runtime.WaypointRoute == 0 then
        Notify("Waypoint Route", "Add at least one checkpoint first.")
        return
    end

    if Runtime.RouteRunning then
        if Runtime.RoutePaused then
            Runtime.RoutePaused = false
            Runtime.RouteStatus = "Running"
            Runtime.UpdateRouteUI()
            Notify("Waypoint Route", "Route resumed.")
        else
            Notify("Waypoint Route", "The route is already running.")
        end

        return
    end

    Runtime.RouteCurrentIndex = math.clamp(
        Runtime.RouteCurrentIndex,
        1,
        #Runtime.WaypointRoute
    )

    Runtime.RouteRunId += 1
    local ThisRun = Runtime.RouteRunId

    Runtime.RouteRunning = true
    Runtime.RoutePaused = false
    Runtime.RouteStatus = "Running"
    Runtime.UpdateRouteUI()

    task.spawn(function()
        while Runtime.RouteRunning
            and Runtime.RouteRunId == ThisRun
            and not Unloaded do

            while Runtime.RoutePaused
                and Runtime.RouteRunning
                and Runtime.RouteRunId == ThisRun
                and not Unloaded do

                task.wait(0.05)
            end

            if not Runtime.RouteRunning
                or Runtime.RouteRunId ~= ThisRun
                or Unloaded then

                break
            end

            if Runtime.RouteCurrentIndex > #Runtime.WaypointRoute then
                if Runtime.RouteRepeatMode == "Repeat" then
                    Runtime.RouteCurrentIndex = 1
                else
                    Runtime.RouteRunning = false
                    Runtime.RoutePaused = false
                    Runtime.RouteStatus = "Completed"
                    Runtime.RouteCurrentIndex = 1
                    Runtime.UpdateRouteUI()
                    Notify("Waypoint Route", "Route completed once.")
                    break
                end
            end

            local WaypointName =
                Runtime.WaypointRoute[Runtime.RouteCurrentIndex]
            local WaypointData = Waypoints[WaypointName]
            local TargetCFrame = DecodeCFrame(WaypointData)
            local R = Root()

            if not WaypointData or not TargetCFrame then
                Notify(
                    "Waypoint Route",
                    tostring(WaypointName)
                    .. " is missing or invalid. Route stopped."
                )
                Runtime.StopWaypointRoute(true)
                break
            end

            if not R then
                Notify(
                    "Waypoint Route",
                    "Your character is unavailable. Route stopped."
                )
                Runtime.StopWaypointRoute(true)
                break
            end

            Runtime.RouteStatus = "Running"
            Runtime.UpdateRouteUI()
            R.CFrame = TargetCFrame

            local HasAnotherTeleport =
                Runtime.RouteCurrentIndex < #Runtime.WaypointRoute
                or Runtime.RouteRepeatMode == "Repeat"

            if HasAnotherTeleport then
                local Waited = 0

                while Waited < Runtime.RouteDelay
                    and Runtime.RouteRunning
                    and Runtime.RouteRunId == ThisRun
                    and not Unloaded do

                    if Runtime.RoutePaused then
                        task.wait(0.05)
                    else
                        local Step = math.min(
                            0.10,
                            Runtime.RouteDelay - Waited
                        )

                        task.wait(Step)
                        Waited += Step
                    end
                end
            end

            if Runtime.RouteRunning
                and Runtime.RouteRunId == ThisRun then

                Runtime.RouteCurrentIndex += 1
            end
        end
    end)
end

