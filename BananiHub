local function SetTracers(Value)
    State.TracersEnabled = Value
    
    if not Value then
        if Runtime.TracerConnection then
            Runtime.TracerConnection:Disconnect()
            Runtime.TracerConnection = nil
        end
        for _, Line in pairs(Runtime.ESPObjects) do
            if Line then pcall(function() Line:Destroy() end) end
        end
        Runtime.ESPObjects = setmetatable({}, {__mode = "k"})
        return
    end
    
    local Accumulator = 0
    Runtime.TracerConnection = RunService.RenderStepped:Connect(function(Delta)
        Accumulator += Delta
        if Accumulator < 0.05 then return end
        Accumulator = 0
        
        local R = Root()
        if not R then return end
        
        for _, Target in ipairs(Players:GetPlayers()) do
            if Target == Player then continue end
            
            local TargetR = Target.Character and Target.Character:FindFirstChild("HumanoidRootPart")
            if not TargetR then continue end
            
            local LineName = "Tracer_" .. Target.UserId
            local Line = Runtime.ESPObjects[LineName]
            
            if not Line then
                Line = Instance.new("Line")
                Line.Name = LineName
                Line.Parent = workspace
                Runtime.ESPObjects[LineName] = Line
            end
            
            if Line then
                local FromScreen = Camera:WorldToScreenPoint(R.Position)
                local ToScreen = Camera:WorldToScreenPoint(TargetR.Position)
                
                Line.From = Vector2.new(FromScreen.X, FromScreen.Y)
                Line.To = Vector2.new(ToScreen.X, ToScreen.Y)
                Line.Color = Target.TeamColor and Target.TeamColor.Color or Color3.fromRGB(255, 0, 0)
                Line.Thickness = 2
            end
        end
    end)
    
    LogSuccess("Tracers " .. (Value and "enabled" or "disabled"))
end

--==============================================================
-- WAYPOINT TWEENING
--==============================================================

local function TweenToWaypoint(TargetCFrame, Duration)
    local R = Root()
    if not R then return false end
    
    local StartTime = tick()
    local StartCFrame = R.CFrame
    
    while tick() - StartTime < Duration and R and R.Parent do
        local Progress = (tick() - StartTime) / Duration
        R.CFrame = StartCFrame:Lerp(TargetCFrame, math.clamp(Progress, 0, 1))
        RunService.Heartbeat:Wait()
    end
    
    if R then R.CFrame = TargetCFrame end
    return true
end

