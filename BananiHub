local SafetyTiers = {
	COSMETIC = 1,
	MOVEMENT = 2,
	DETECTION = 3,
	HOSTILE = 4
}

local SafetyState = {
	CurrentTier = SafetyTiers.MOVEMENT,
	Locked = false,
	Reason = nil
}

local function CheckSafetyTier(RequiredTier)
	if SafetyState.Locked and SafetyState.CurrentTier < RequiredTier then
		return false, SafetyState.Reason or "Safety tier restriction"
	end
	return true, nil
end

local function SetSafetyTier(NewTier, Reason)
	SafetyState.CurrentTier = NewTier
	SafetyState.Reason = Reason
	LogInformation("Safety tier set to: " .. tostring(NewTier), "System")
end

--============================================================== --
-- THREAD POOL FOR SCRIPT EXECUTION
--============================================================== --

local ExecutionPool = {
	threads = {},
	queue = {},
	active = true,
	pool_size = 8,
	worker_count = 0
}

function ExecutionPool:spawn_worker()
	local worker_id = self.worker_count + 1
	self.worker_count = worker_id
	
	local worker = coroutine.create(function()
		while self.active do
			local task = table.remove(self.queue, 1)
			if task then
				local success, result = pcall(task.fn, unpack(task.args or {}))
				if task.callback then
					pcall(task.callback, success, result)
				end
			else
				wait(0.01)
			end
		end
	end)
	
	coroutine.resume(worker)
	table.insert(self.threads, worker)
end

function ExecutionPool:init()
	for i = 1, self.pool_size do
		self:spawn_worker()
	end
	LogSuccess("Execution pool initialized with " .. self.pool_size .. " workers", "ExecutionPool")
end

function ExecutionPool:execute(fn, args, callback)
	if not self.active then return false end
	table.insert(self.queue, {
		fn = fn,
		args = args or {},
		callback = callback
	})
	return true
end

function ExecutionPool:shutdown()
	self.active = false
	for _, thread in ipairs(self.threads) do
		pcall(function() coroutine.close(thread) end)
	end
	self.threads = {}
	self.queue = {}
	self.worker_count = 0
end

function ExecutionPool:get_status()
	return {
		active = self.active,
		workers = #self.threads,
		queue_size = #self.queue
	}
end

