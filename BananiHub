                    "🍌 BANANIHUB 🍌",
                    "Settings are working."
                )
            end
        })

        if Runtime.CurrentThemeName ~= "Default"
            and ThemePresets[Runtime.CurrentThemeName] then

            task.defer(function()
                ApplyPresetTheme(Runtime.CurrentThemeName)
            end)
        end

        Runtime.UpdatePreferenceDisplays()

        SettingsTab:CreateSection("🧹 Script Management")

        SettingsTab:CreateButton({
            Name = "🚨 Master Reset",
            Callback = MasterReset
        })

        SettingsTab:CreateButton({
            Name = "🗑️ Unload 🍌 BANANIHUB 🍌",
            Callback = UnloadBananiHub
        })
    end)

    if not BuildSuccess then
        warn(
            "BANANIHUB | Settings tab failed: "
            .. tostring(BuildError)
        )
        LogError(
            "Settings tab failed: "
            .. tostring(BuildError),
            "Settings"
        )
    end
end

end
