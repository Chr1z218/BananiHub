        if RecordingMacro == MacroName then
            table.insert(MacroEvents[MacroName], {
                Type = "KeyUp",
                KeyCode = Input.KeyCode,
                Time = tick()
            })
        end
    end)
    
    Macros[MacroName] = {
        Recording = true,
        Connection1 = KeyConnection,
        Connection2 = ReleaseConnection
    }
    
    LogInformation("Recording macro: " .. MacroName, "Macro")
    return true
end

local function StopMacroRecording(MacroName)
    if RecordingMacro ~= MacroName then return false end
    
    local Macro = Macros[MacroName]
    if Macro then
        if Macro.Connection1 then Macro.Connection1:Disconnect() end
        if Macro.Connection2 then Macro.Connection2:Disconnect() end
        Macro.Recording = false
    end
    
    RecordingMacro = nil
    
    if MacroEvents[MacroName] and #MacroEvents[MacroName] > 0 then
        local Events = MacroEvents[MacroName]
        local StartTime = Events[1].Time
        for _, Event in ipairs(Events) do
            Event.RelativeTime = Event.Time - StartTime
        end
        Macros[MacroName].Events = Events
        LogSuccess("Macro saved: " .. MacroName, "Macro")
        return true
    end
    
    return false
end

local function PlayMacro(MacroName)
    local Macro = Macros[MacroName]
    if not Macro or not Macro.Events then return false end
    
    task.spawn(function()
        local PreviousTime = 0
        for _, Event in ipairs(Macro.Events) do
            local Delay = Event.RelativeTime - PreviousTime
            if Delay > 0 then task.wait(Delay) end
            
            if Event.Type == "KeyDown" then
                UserInputService:SendKeyEvent(true, Event.KeyCode, false)
            elseif Event.Type == "KeyUp" then
                UserInputService:SendKeyEvent(false, Event.KeyCode, false)
            end
            
            PreviousTime = Event.RelativeTime
        end
        LogSuccess("Macro playback complete: " .. MacroName, "Macro")
    end)
    
    return true
end

